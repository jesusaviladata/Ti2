# Application
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
DEBUG=true
APP_ENV=development
APP_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_USER=infra_user
POSTGRES_PASSWORD=CHANGE_ME_database_password
POSTGRES_DB=infra_platform
DATABASE_URL=postgresql+asyncpg://infra_user:CHANGE_ME_database_password@db:5432/infra_platform

# CORS: JSON list for app.main
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost"]

# Session cookies. Production requires COOKIE_SECURE=1 and HTTPS APP_ORIGIN.
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Login rate limiting stored in PostgreSQL
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW_SEC=300

# Optional local file manager allowlist. Separate roots with semicolons.
# FM_ALLOWED_ROOTS=D:\Datos;D:\Respaldos

# Development-only SQLite path used by dev_server.py
# DB_PATH=./infra_platform.db

# Same-origin frontend defaults
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
